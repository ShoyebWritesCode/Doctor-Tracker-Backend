{
  "name": "doctor-tracker-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone REST API for the Doctor Tracker administrative application.",
  "type": "module",
  "engines": {
    "node": ">=22.17.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "overrides": {
    "minimatch": "11.0.7"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:runtime": "node --input-type=module -e \"const { createRuntimeApp } = await import('./dist/runtime.js'); const { parseEnv } = await import('./dist/config/env.js'); const { createLogger } = await import('./dist/config/logger.js'); createRuntimeApp(parseEnv({ NODE_ENV: 'test', MONGODB_URI: 'mongodb://unused/runtime_check', FRONTEND_ORIGIN: 'http://localhost:3000' }), createLogger({ nodeEnv: 'test', level: 'silent' })); await import('./dist/scripts/seed-admin.js'); await import('./dist/scripts/seed-demo.js');\"",
    "test:auth-server": "tsx tests/helpers/auth-browser-server.ts",
    "test:coverage": "vitest run --coverage",
    "test:load": "tsx tests/performance/read-load.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
