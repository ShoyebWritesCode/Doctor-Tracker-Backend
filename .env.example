NODE_ENV=development
HOST=0.0.0.0
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_tracker?replicaSet=rs0
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=doctor_tracker_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
TRUST_PROXY_HOPS=0
LOGIN_IP_LIMIT=20
LOGIN_ACCOUNT_LIMIT=5
LOG_LEVEL=debug
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_NAME=Demo Administrator
SEED_ADMIN_PASSWORD=replace-with-a-local-demo-password
